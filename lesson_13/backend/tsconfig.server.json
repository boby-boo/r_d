{
    "compilerOptions": {
      "target": "ES2022",
      "lib": ["ES2022"],
      "module": "commonjs",
      "moduleResolution": "commonjs",
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
      "strict": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "allowImportingTsExtensions": true,
      "noEmit": true
    },
    "include": ["src/**/*.ts"]
  }